    "nfc_error" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsabbruch - sobald die Karte erkannt wird, Karte und Handy nicht mehr bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnection - as soon as the card is recognized, stop moving the card and phone."
          }
        }
      }
    },
    "nfc_txt_connectionErrorMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindungsabbruch. Karte oder Handy wurden bewegt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection lost. The card or phone was moved."
          }
        }
      }
    },
    "nfc_txt_connectMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "eGK gefunden. Karte und iPhone nicht mehr bewegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health card found. Keep the card and iPhone still."
          }
        }
      }
    },
