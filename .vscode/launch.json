{
  // One configuration per example app flavor, see example/lib/flavor.dart. example/.vscode/launch.json has the same
  // ones for opening the example folder on its own, Android Studio and IntelliJ in .run/.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Example: demo",
      "type": "dart",
      "request": "launch",
      "cwd": "example",
      "program": "lib/main.dart",
      "toolArgs": ["--flavor", "demo"]
    },
    {
      "name": "Example: singleEntryPoint",
      "type": "dart",
      "request": "launch",
      "cwd": "example",
      "program": "lib/main.dart",
      "toolArgs": ["--flavor", "singleEntryPoint"]
    },
    {
      "name": "Example: demo, E2E harness",
      "type": "dart",
      "request": "launch",
      "cwd": "example",
      "program": "lib/main.dart",
      "toolArgs": ["--flavor", "demo", "--dart-define=iaE2E=true"]
    }
  ]
}
