# Per-developer local settings. Copy to `.env.local` (gitignored) and fill in.
# Unlike `.env` (shared, from 1Password), this file is personal and never downloaded/overwritten.

# Absolute path to your local checkouts of the IA SDK repos. Used by the `ia-connect-local-spm`, `ia-show-problems` but also it gives claude more context when asking any question. 
IA_SDK_IOS_APP_PATH=...
IA_SDK_ANDROID_APP_PATH=...